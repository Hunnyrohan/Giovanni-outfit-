# Server
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development

# Active model provider
MODEL_PROVIDER=catvton
MODEL_DEVICE=auto
MODEL_PRECISION=fp16

# Memory optimization (tuned for constrained/low-VRAM GPUs).
# CPU offload and attention slicing default to false: verified on a real
# RTX 3050 (4GB) to crash CatVTON's custom attention architecture. See
# app/providers/catvton_provider.py for the exact errors. fp16 + VAE slicing
# alone measured ~2.4GB peak VRAM at 384x512 on that GPU - no need for them.
ENABLE_CPU_OFFLOAD=false
ENABLE_ATTENTION_SLICING=false
ENABLE_VAE_SLICING=true
IMAGE_WIDTH=384
IMAGE_HEIGHT=512

# Storage
UPLOAD_DIR=uploads
OUTPUT_DIR=outputs
MAX_UPLOAD_SIZE_MB=10

# Logging
LOG_LEVEL=INFO
