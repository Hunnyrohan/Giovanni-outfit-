{
  "info": {
    "name": "StyleSense AI - Authentication",
    "description": "Postman collection for the StyleSense AI Authentication module. Run requests in order: Register or Login, Me, Refresh, Logout.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.collectionVariables.get('email')) {",
          "  pm.collectionVariables.set('email', `giovanni.${Date.now()}@example.com`);",
          "}",
          "if (!pm.collectionVariables.get('password')) {",
          "  pm.collectionVariables.set('password', 'Password123');",
          "}"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api",
      "type": "string"
    },
    {
      "key": "androidBaseUrl",
      "value": "http://10.0.2.2:3000/api",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "refreshToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "email",
      "value": "",
      "type": "string"
    },
    {
      "key": "password",
      "value": "Password123",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 Register",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 201', () => pm.response.to.have.status(201));",
              "const json = pm.response.json();",
              "pm.test('success response', () => pm.expect(json.success).to.eql(true));",
              "pm.test('returns tokens', () => {",
              "  pm.expect(json.data.tokens.accessToken).to.be.a('string').and.not.empty;",
              "  pm.expect(json.data.tokens.refreshToken).to.be.a('string').and.not.empty;",
              "});",
              "pm.collectionVariables.set('accessToken', json.data.tokens.accessToken);",
              "pm.collectionVariables.set('refreshToken', json.data.tokens.refreshToken);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fullName\": \"Giovanni Rossi\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"gender\": \"MALE\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/auth/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "register"
          ]
        },
        "description": "Creates a new user, stores accessToken and refreshToken in collection variables, and sets an HTTP-only refresh cookie when cookies are enabled."
      },
      "response": []
    },
    {
      "name": "02 Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "const json = pm.response.json();",
              "pm.test('success response', () => pm.expect(json.success).to.eql(true));",
              "pm.collectionVariables.set('accessToken', json.data.tokens.accessToken);",
              "pm.collectionVariables.set('refreshToken', json.data.tokens.refreshToken);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "login"
          ]
        },
        "description": "Authenticates an existing user and refreshes collection token variables."
      },
      "response": []
    },
    {
      "name": "02b Google Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200 when idToken is valid', () => {",
              "  pm.expect([200, 401, 500]).to.include(pm.response.code);",
              "});",
              "const json = pm.response.json();",
              "if (pm.response.code === 200) {",
              "  pm.collectionVariables.set('accessToken', json.data.tokens.accessToken);",
              "  pm.collectionVariables.set('refreshToken', json.data.tokens.refreshToken);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"idToken\": \"PASTE_GOOGLE_ID_TOKEN_HERE\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/auth/google",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "google"
          ]
        },
        "description": "Paste a real Google ID token from Flutter Google Sign-In. The token audience must match GOOGLE_CLIENT_ID in backend/.env."
      },
      "response": []
    },
    {
      "name": "03 Get Current User",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "const json = pm.response.json();",
              "pm.test('success response', () => pm.expect(json.success).to.eql(true));",
              "pm.test('does not expose password', () => pm.expect(json.data.user.password).to.eql(undefined));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/auth/me",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "me"
          ]
        },
        "description": "Protected route. Requires Authorization: Bearer {{accessToken}}."
      },
      "response": []
    },
    {
      "name": "04 Refresh Access Token",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "const json = pm.response.json();",
              "pm.test('success response', () => pm.expect(json.success).to.eql(true));",
              "pm.collectionVariables.set('accessToken', json.data.tokens.accessToken);",
              "pm.collectionVariables.set('refreshToken', json.data.tokens.refreshToken);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/auth/refresh",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "refresh"
          ]
        },
        "description": "Rotates refresh token and access token. Also supports the refreshToken cookie."
      },
      "response": []
    },
    {
      "name": "05 Logout",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "const json = pm.response.json();",
              "pm.test('success response', () => pm.expect(json.success).to.eql(true));",
              "pm.collectionVariables.set('accessToken', '');",
              "pm.collectionVariables.set('refreshToken', '');"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/auth/logout",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "logout"
          ]
        },
        "description": "Invalidates the stored refresh token hash and clears the refresh cookie."
      },
      "response": []
    }
  ]
}
