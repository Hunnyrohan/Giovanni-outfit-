{
  "info": {
    "name": "StyleSense AI - Saved Outfits",
    "description": "Postman collection for the StyleSense AI Saved Outfits module. Run 01 Login (Authentication collection) and add at least one wardrobe item (Wardrobe collection) first.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api",
      "type": "string"
    },
    {
      "key": "androidBaseUrl",
      "value": "http://10.0.2.2:3000/api",
      "type": "string"
    },
    { "key": "accessToken", "value": "", "type": "string" },
    { "key": "savedOutfitId", "value": "", "type": "string" },
    { "key": "wardrobeItemId", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "01 Create Saved Outfit",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 201', () => pm.response.to.have.status(201));",
              "const json = pm.response.json();",
              "pm.test('success response', () => pm.expect(json.success).to.eql(true));",
              "pm.collectionVariables.set('savedOutfitId', json.data.savedOutfit.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{accessToken}}" }
        ],
        "body": {
          "mode": "formdata",
          "formdata": [
            { "key": "name", "value": "Weekend Casual", "type": "text" },
            { "key": "notes", "value": "Comfy weekend look", "type": "text" },
            { "key": "occasion", "value": "CASUAL", "type": "text" },
            { "key": "season", "value": "AUTUMN", "type": "text" },
            { "key": "wardrobeItemIds", "value": "{{wardrobeItemId}}", "type": "text" },
            { "key": "coverImage", "type": "file", "src": "" }
          ]
        },
        "url": {
          "raw": "{{baseUrl}}/saved-outfits",
          "host": ["{{baseUrl}}"],
          "path": ["saved-outfits"]
        },
        "description": "Set the wardrobeItemId collection variable to a real id from the Wardrobe collection's Add Wardrobe Item response first. coverImage is optional; leave the file field empty to create without a cover."
      },
      "response": []
    },
    {
      "name": "02 List Saved Outfits",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "const json = pm.response.json();",
              "pm.test('success response', () => pm.expect(json.success).to.eql(true));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{accessToken}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/saved-outfits?page=1&limit=20",
          "host": ["{{baseUrl}}"],
          "path": ["saved-outfits"],
          "query": [
            { "key": "page", "value": "1" },
            { "key": "limit", "value": "20" }
          ]
        }
      },
      "response": []
    },
    {
      "name": "03 Get Saved Outfit",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "const json = pm.response.json();",
              "pm.test('success response', () => pm.expect(json.success).to.eql(true));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{accessToken}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/saved-outfits/{{savedOutfitId}}",
          "host": ["{{baseUrl}}"],
          "path": ["saved-outfits", "{{savedOutfitId}}"]
        }
      },
      "response": []
    },
    {
      "name": "04 Update Saved Outfit",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "const json = pm.response.json();",
              "pm.test('success response', () => pm.expect(json.success).to.eql(true));"
            ]
          }
        }
      ],
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{accessToken}}" }
        ],
        "body": {
          "mode": "formdata",
          "formdata": [
            { "key": "name", "value": "Weekend Casual v2", "type": "text" },
            { "key": "addWardrobeItemIds", "value": "{{wardrobeItemId}}", "type": "text" }
          ]
        },
        "url": {
          "raw": "{{baseUrl}}/saved-outfits/{{savedOutfitId}}",
          "host": ["{{baseUrl}}"],
          "path": ["saved-outfits", "{{savedOutfitId}}"]
        },
        "description": "addWardrobeItemIds/removeWardrobeItemIds accept repeated form fields, a JSON array string, or a comma-separated string."
      },
      "response": []
    },
    {
      "name": "05 Set Favorite",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "const json = pm.response.json();",
              "pm.test('success response', () => pm.expect(json.success).to.eql(true));"
            ]
          }
        }
      ],
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{accessToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"isFavorite\": true\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{baseUrl}}/saved-outfits/{{savedOutfitId}}/favorite",
          "host": ["{{baseUrl}}"],
          "path": ["saved-outfits", "{{savedOutfitId}}", "favorite"]
        }
      },
      "response": []
    },
    {
      "name": "06 Duplicate Saved Outfit",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 201', () => pm.response.to.have.status(201));",
              "const json = pm.response.json();",
              "pm.test('success response', () => pm.expect(json.success).to.eql(true));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{accessToken}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/saved-outfits/{{savedOutfitId}}/duplicate",
          "host": ["{{baseUrl}}"],
          "path": ["saved-outfits", "{{savedOutfitId}}", "duplicate"]
        },
        "description": "Creates a new saved outfit with the same fields and wardrobe item links as the original."
      },
      "response": []
    },
    {
      "name": "07 Delete Saved Outfit",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "const json = pm.response.json();",
              "pm.test('success response', () => pm.expect(json.success).to.eql(true));"
            ]
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{accessToken}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/saved-outfits/{{savedOutfitId}}",
          "host": ["{{baseUrl}}"],
          "path": ["saved-outfits", "{{savedOutfitId}}"]
        },
        "description": "Deletes the saved outfit and its item associations only. The underlying wardrobe items are not deleted."
      },
      "response": []
    }
  ]
}
