generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum ItemCategory {
  TOP
  BOTTOM
  DRESS
  OUTERWEAR
  SHOES
  ACCESSORY
  BAG
  OTHER
}

enum Season {
  SPRING
  SUMMER
  AUTUMN
  WINTER
  ALL_SEASON
}

enum Occasion {
  CASUAL
  FORMAL
  BUSINESS
  PARTY
  SPORTS
  TRAVEL
  DATE
  FESTIVAL
  OTHER
}

enum MessageSender {
  USER
  AI
  SYSTEM
}

enum TryOnStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum NotificationType {
  SYSTEM
  RECOMMENDATION
  VIRTUAL_TRY_ON
  SECURITY
}

model User {
  id                String           @id @default(uuid())
  fullName          String
  email             String           @unique
  password          String
  authProvider      String           @default("LOCAL")
  googleId          String?          @unique
  role              UserRole         @default(USER)
  gender            Gender?
  profileImage      String?
  bio               String?
  phoneNumber       String?
  dateOfBirth       DateTime?
  isEmailVerified   Boolean          @default(false)
  emailVerifiedAt   DateTime?
  twoFactorEnabled  Boolean          @default(false)
  twoFactorSecret   String?
  refreshTokenHash  String?
  resetTokenHash    String?
  resetTokenExpires DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  preference        UserPreference?
  wardrobeItems     WardrobeItem[]
  collections       Collection[]
  savedOutfits      SavedOutfit[]
  outfitHistory     OutfitHistory[]
  chats             Chat[]
  virtualTryOns     VirtualTryOn[]
  recommendations   Recommendation[]
  notifications     Notification[]

  @@index([email])
  @@index([googleId])
}

model UserPreference {
  id              String   @id @default(uuid())
  userId          String   @unique
  preferredStyles String[]
  preferredColors String[]
  dislikedColors  String[]
  sizes           Json?
  weatherEnabled  Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WardrobeItem {
  id              String           @id @default(uuid())
  userId          String
  name            String
  description     String?
  imageUrl        String
  category        ItemCategory
  subCategory     String?
  primaryColor    String?
  colors          String[]
  brand           String?
  size            String?
  material        String?
  season          Season           @default(ALL_SEASON)
  occasion        Occasion[]
  tags            String[]
  isFavorite      Boolean          @default(false)
  isArchived      Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  collectionItems CollectionItem[]
  savedOutfitItems SavedOutfitItem[]
  virtualTryOns   VirtualTryOn[]

  @@index([userId])
  @@index([category])
  @@index([isFavorite])
}

model Collection {
  id          String           @id @default(uuid())
  userId      String
  name        String
  description String?
  coverImage  String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  items       CollectionItem[]

  @@unique([userId, name])
  @@index([userId])
}

model CollectionItem {
  id             String       @id @default(uuid())
  collectionId   String
  wardrobeItemId String
  order          Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  collection     Collection   @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  wardrobeItem   WardrobeItem @relation(fields: [wardrobeItemId], references: [id], onDelete: Cascade)

  @@unique([collectionId, wardrobeItemId])
  @@index([wardrobeItemId])
}

model SavedOutfit {
  id          String            @id @default(uuid())
  userId      String
  title       String
  notes       String?
  imageUrl    String?
  occasion    Occasion?
  season      Season?
  score       Int?
  isFavorite  Boolean           @default(false)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  items       SavedOutfitItem[]

  @@index([userId])
}

model SavedOutfitItem {
  id             String       @id @default(uuid())
  savedOutfitId  String
  wardrobeItemId String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  savedOutfit    SavedOutfit  @relation(fields: [savedOutfitId], references: [id], onDelete: Cascade)
  wardrobeItem   WardrobeItem @relation(fields: [wardrobeItemId], references: [id], onDelete: Cascade)

  @@unique([savedOutfitId, wardrobeItemId])
  @@index([wardrobeItemId])
}

model OutfitHistory {
  id        String    @id @default(uuid())
  userId    String
  title     String
  imageUrl  String?
  occasion  Occasion?
  score     Int?
  notes     String?
  wornAt    DateTime  @default(now())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([wornAt])
}

model Chat {
  id          String    @id @default(uuid())
  userId      String
  title       String
  summary     String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages    Message[]

  @@index([userId])
}

model Message {
  id        String        @id @default(uuid())
  chatId    String
  sender    MessageSender
  content   String
  metadata  Json?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  chat      Chat          @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@index([chatId])
  @@index([sender])
}

model Recommendation {
  id          String    @id @default(uuid())
  userId      String
  title       String
  type        String
  occasion    Occasion?
  payload     Json
  score       Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
}

model VirtualTryOn {
  id              String        @id @default(uuid())
  userId          String
  wardrobeItemId  String?
  personImageUrl  String
  clothingImageUrl String
  resultImageUrl  String?
  provider        String        @default("catvton")
  providerJobId   String?
  status          TryOnStatus   @default(PENDING)
  processingTime  Float?
  errorMessage    String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  wardrobeItem    WardrobeItem? @relation(fields: [wardrobeItemId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
  @@index([wardrobeItemId])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType @default(SYSTEM)
  title     String
  message   String
  isRead    Boolean          @default(false)
  metadata  Json?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
}
